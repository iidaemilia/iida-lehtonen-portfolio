---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

import Container from "../../components/Container.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const articles = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });
---

<BaseLayout
  title="Writing | Iida Lehtonen"
  description="Articles about SEO, AI, content strategy and web development by Iida Lehtonen."
>
  <Header />

  <main class="writing-page">
    <Container>
      <header class="writing-header">
        <p class="writing-header__eyebrow">Ideas & observations</p>
        <h1>Writing</h1>
        <p class="writing-header__intro">
          Notes on SEO, AI, content strategy and building better digital
          experiences.
        </p>
      </header>

      <section class="article-list" aria-label="Articles">
        {articles.map((article, index) => (
          <article class="article-card">
            <a class="article-card__link" href={`/writing/${article.id}/`}>
              <div class="article-card__image">
                <Image
                  src={article.data.heroImage}
                  alt={article.data.heroAlt}
                  widths={[480, 720, 960]}
                  sizes="(max-width: 768px) calc(100vw - 2rem), 45vw"
                  format="webp"
                  loading={index === 0 ? "eager" : "lazy"}
                />
              </div>

              <div class="article-card__content">
                <div class="article-card__meta">
                  <time datetime={article.data.publishDate.toISOString()}>
                    {formatDate(article.data.publishDate)}
                  </time>
                  <span aria-hidden="true"></span>
                  <span>{article.data.readingTime} min read</span>
                </div>

                <h2>{article.data.title}</h2>
                <p class="article-card__excerpt">{article.data.excerpt}</p>

                <div class="article-card__tags" aria-label="Topics">
                  {article.data.tags.map((tag) => <span>{tag}</span>)}
                </div>

                <span class="article-card__cta">Read article <span aria-hidden="true">→</span></span>
              </div>
            </a>
          </article>
        ))}
      </section>
    </Container>
  </main>

  <Footer />
</BaseLayout>

<style>
  .writing-page {
    padding-top: 5.5rem;
  }

  .writing-header {
    max-width: 50rem;
    padding-block: clamp(3rem, 6vw, 5rem) clamp(2.5rem, 5vw, 3.5rem);
  }

  .writing-header__eyebrow {
    margin-bottom: var(--space-sm);
    color: var(--color-accent);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .writing-header h1 {
    font-size: clamp(4rem, 10vw, 7rem);
  }

  .writing-header__intro {
    max-width: 42rem;
    margin-top: var(--space-md);
    font-size: clamp(1.15rem, 2vw, 1.35rem);
  }

  .article-list {
    padding: 0;
  }

  .article-card {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .article-card__link {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(20rem, 0.9fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }

  .article-card__image {
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: var(--color-surface);
  }

  .article-card__image :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .article-card__link:hover .article-card__image :global(img) {
    transform: scale(1.025);
  }

  .article-card__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .article-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: var(--space-sm);
    color: var(--color-text-muted);
    font-size: 0.75rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .article-card__meta > span[aria-hidden="true"] {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: currentColor;
  }

  .article-card h2 {
    color: var(--color-text);
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 3.25rem);
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .article-card__excerpt {
    margin-top: var(--space-sm);
    font-size: 1.05rem;
  }

  .article-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }

  .article-card__tags span {
    color: var(--color-accent);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .article-card__tags span:not(:last-child)::after {
    margin-left: 0.5rem;
    color: var(--color-text-muted);
    content: "/";
  }

  .article-card__cta {
    margin-top: var(--space-md);
    padding-bottom: 0.2rem;
    border-bottom: 1px solid var(--color-accent);
    color: var(--color-text);
    font-size: 0.9rem;
    font-weight: 600;
    transition: color 0.2s ease;
  }

  .article-card__link:hover .article-card__cta {
    color: var(--color-accent);
  }

  @media (max-width: 768px) {
    .writing-page {
      padding-top: 4.75rem;
    }

    .writing-header {
      padding-block: 2.75rem 2.5rem;
    }

    .article-card__link {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }

    .article-card__image {
      aspect-ratio: 16 / 9;
    }
  }
</style>
