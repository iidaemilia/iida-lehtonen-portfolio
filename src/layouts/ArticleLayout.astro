---
import { getImage, Image } from "astro:assets";
import type { ImageMetadata } from "astro";

import AuthorBox from "../components/AuthorBox.astro";
import Container from "../components/Container.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import BaseLayout from "./BaseLayout.astro";

interface Frontmatter {
  title: string;
  description: string;
  excerpt: string;
  publishDate: Date;
  updatedDate?: Date;
  heroImage: ImageMetadata;
  heroAlt: string;
  author: string;
  readingTime: number;
  tags: string[];
}

interface Props {
  frontmatter: Frontmatter;
}

const { frontmatter } = Astro.props;

const formattedPublishDate = frontmatter.publishDate.toLocaleDateString("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
});

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const socialImage = await getImage({
  src: frontmatter.heroImage,
  width: 1200,
  height: 630,
  fit: "cover",
  format: "jpg",
});
const socialImageUrl = new URL(socialImage.src, Astro.site);

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: frontmatter.title,
  description: frontmatter.description,
  image: socialImageUrl.href,
  datePublished: frontmatter.publishDate.toISOString(),
  ...(frontmatter.updatedDate && {
    dateModified: frontmatter.updatedDate.toISOString(),
  }),
  author: {
    "@type": "Person",
    name: frontmatter.author,
    url: "https://iidalehtonen.com/",
  },
  publisher: {
    "@type": "Person",
    name: "Iida Lehtonen",
    url: "https://iidalehtonen.com/",
  },
  mainEntityOfPage: canonicalUrl.href,
};
---

<BaseLayout
  title={`${frontmatter.title} | Iida Lehtonen`}
  description={frontmatter.description}
  image={socialImage.src}
  imageAlt={frontmatter.heroAlt}
  imageWidth={1200}
  imageHeight={630}
  type="article"
  publishDate={frontmatter.publishDate}
  updatedDate={frontmatter.updatedDate}
  tags={frontmatter.tags}
  schema={articleSchema}
>
  <Header />

  <main class="article-page">
    <article>
      <Container>
        <header class="article__header">
          <div class="article__meta" aria-label="Article information">
            {frontmatter.tags[0] && (
              <span class="article__category">{frontmatter.tags[0]}</span>
            )}
            <span class="article__separator" aria-hidden="true"></span>
            <time datetime={frontmatter.publishDate.toISOString()}>
              {formattedPublishDate}
            </time>
            <span class="article__separator" aria-hidden="true"></span>
            <span>{frontmatter.readingTime} min read</span>
          </div>

          <h1>{frontmatter.title}</h1>

          <p class="article__lead">{frontmatter.excerpt}</p>
        </header>

        <figure class="article__hero">
          <Image
            class="article__hero-image"
            src={frontmatter.heroImage}
            alt={frontmatter.heroAlt}
            widths={[640, 1660, 1024]}
            sizes="(max-width: 1024px) calc(100vw - 2rem), 992px"
            format="webp"
            loading="eager"
            fetchpriority="high"
          />
        </figure>

        <div class="article__body">
          <slot />
        </div>

        <div class="article__footer">
          <div class="article__tags" aria-label="Article topics">
            {frontmatter.tags.map((tag) => <span>{tag}</span>)}
          </div>
          <AuthorBox />
        </div>
      </Container>
    </article>
  </main>

  <Footer />
</BaseLayout>

<style>
  .article-page {
    padding-top: 5.5rem;
  }

  article {
    padding-block: clamp(3.5rem, 8vw, 7rem) 0;
  }

  .article__header {
    max-width: 58rem;
    margin-inline: auto;
    text-align: center;
  }

  .article__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    margin-bottom: var(--space-md);
    color: var(--color-text-muted);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .article__category {
    color: var(--color-accent);
  }

  .article__separator {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.65;
  }

  .article__header h1 {
    font-size: clamp(3.25rem, 8vw, 6.5rem);
    text-wrap: balance;
  }

  .article__lead {
    max-width: 46rem;
    margin: var(--space-md) auto 0;
    color: var(--color-text-muted);
    font-family: var(--font-heading);
    font-size: clamp(1.35rem, 2.4vw, 1.85rem);
    line-height: 1.45;
    text-wrap: balance;
  }

  .article__hero {
    width: min(100%, 62rem);
    aspect-ratio: 5 / 2;
    margin: clamp(3rem, 7vw, 5rem) auto clamp(3.5rem, 8vw, 6rem);
    overflow: hidden;
    background: var(--color-surface);
  }

  .article__hero :global(.article__hero-image) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .article__body,
  .article__footer {
    width: min(100%, 50rem);
    margin-inline: auto;
  }

  .article__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding-block: var(--space-md);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .article__tags span {
    padding: 0.5rem 0.8rem;
    border: 1px solid rgba(200, 169, 106, 0.4);
    color: var(--color-accent);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  @media (max-width: 768px) {
    .article-page {
      padding-top: 4.75rem;
    }

    article {
      padding-top: 3rem;
    }

    .article__meta {
      gap: 0.5rem;
    }

    .article__header h1 {
      font-size: clamp(2.75rem, 14vw, 4.5rem);
    }

    .article__hero {
      width: auto;
      margin-inline: -1rem;
    }
  }
</style>

<style is:global>
  .article__body {
    color: var(--color-text-muted);
    font-size: clamp(1rem, 1.5vw, 1.1rem);
    line-height: 1.85;
  }

  .article__body > :first-child {
    margin-top: 0;
  }

  .article__body > :last-child {
    margin-bottom: 0;
  }

  .article__body p,
  .article__body ul,
  .article__body ol,
  .article__body blockquote,
  .article__body pre,
  .article__body table,
  .article__body figure {
    margin-block: 0 1.75rem;
  }

  .article__body h2,
  .article__body h3,
  .article__body h4,
  .article__body h5,
  .article__body h6 {
    color: var(--color-text);
    font-family: var(--font-body);
    text-wrap: balance;
  }

  .article__body h2 {
    margin: 4rem 0 1.25rem;
    font-size: clamp(2.25rem, 5vw, 3.3rem);
    letter-spacing: -0.02em;
  }

  .article__body h3 {
    margin: 2.75rem 0 1rem;
    font-size: clamp(1.6rem, 3vw, 2.1rem);
  }

  .article__body strong {
    color: var(--color-text);
    font-weight: 600;
  }

  .article__body a {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-color: rgba(200, 169, 106, 0.5);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    transition: text-decoration-color 0.2s ease;
  }

  .article__body a:hover {
    text-decoration-color: currentColor;
  }

  .article__body ul,
  .article__body ol {
    padding-left: 1.4rem;
  }

  .article__body li {
    padding-left: 0.35rem;
    margin-bottom: 0.65rem;
  }

  .article__body li::marker {
    color: var(--color-accent);
    font-size: inherit;
    font-weight: 600;
  }

  .article__body blockquote {
    position: relative;
    padding: 0.4rem 0 0.4rem 2rem;
    border-left: 2px solid var(--color-accent);
  }

  .article__body blockquote p {
    color: var(--color-text);
    font-family: var(--font-heading);
    font-size: clamp(1.4rem, 3vw, 1.85rem);
    font-style: italic;
    line-height: 1.5;
  }

  .article__body blockquote p:last-child {
    margin-bottom: 0;
  }

  .article__body code {
    padding: 0.15em 0.35em;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    background: var(--color-surface);
    color: var(--color-text);
    font-size: 0.88em;
  }

  .article__body pre {
    overflow-x: auto;
    padding: 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: var(--color-surface);
    line-height: 1.65;
  }

  .article__body pre code {
    padding: 0;
    border: 0;
    background: transparent;
    font-size: 0.9rem;
  }

  .article__body img {
    display: block;
    width: 100%;
    height: auto;
    margin-block: 2.5rem;
  }

  .article__body figcaption {
    margin-top: -1.75rem;
    color: var(--color-text-muted);
    font-size: 0.8rem;
    text-align: center;
  }

  .article__body table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
  }

  .article__body th,
  .article__body td {
    padding: 0.8rem 1rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    text-align: left;
    vertical-align: top;
  }

  .article__body th {
    background: var(--color-surface);
    color: var(--color-text);
    font-weight: 600;
  }

  .article__body hr {
    margin-block: 3.5rem;
    border: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  @media (max-width: 600px) {
    .article__body {
      line-height: 1.75;
    }

    .article__body h2 {
      margin-top: 3rem;
    }

    .article__body blockquote {
      padding-left: 1.25rem;
    }

    .article__body table {
      display: block;
      overflow-x: auto;
      white-space: nowrap;
    }

    .article__body pre {
      margin-inline: -1rem;
      padding: 1.25rem 1rem;
    }
  }
</style>
