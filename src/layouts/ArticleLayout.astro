---
import { getImage, Image } from "astro:assets";
import type { ImageMetadata } from "astro";

import AuthorBox from "../components/AuthorBox.astro";
import Container from "../components/Container.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import BaseLayout from "./BaseLayout.astro";

interface Frontmatter {
  title: string;
  description: string;
  excerpt: string;
  publishDate: Date;
  updatedDate?: Date;
  heroImage: ImageMetadata;
  heroAlt: string;
  author: string;
  readingTime: number;
  tags: string[];
  faq?: {
    question: string;
    answer: string;
  }[];
  sources?: {
    title: string;
    url: string;
  }[];
}

interface Props {
  frontmatter: Frontmatter;
}

const { frontmatter } = Astro.props;

const formattedPublishDate = frontmatter.publishDate.toLocaleDateString("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
});

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const socialImage = await getImage({
  src: frontmatter.heroImage,
  width: 1200,
  height: 630,
  fit: "cover",
  format: "jpg",
});
const socialImageUrl = new URL(socialImage.src, Astro.site);

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: frontmatter.title,
  description: frontmatter.description,
  image: socialImageUrl.href,
  datePublished: frontmatter.publishDate.toISOString(),
  ...(frontmatter.updatedDate && {
    dateModified: frontmatter.updatedDate.toISOString(),
  }),
  author: {
    "@type": "Person",
    name: frontmatter.author,
    url: "https://iidalehtonen.com/",
  },
  publisher: {
    "@type": "Person",
    name: "Iida Lehtonen",
    url: "https://iidalehtonen.com/",
  },
  mainEntityOfPage: canonicalUrl.href,
};

const faqSchema = frontmatter.faq && {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: frontmatter.faq.map(({ question, answer }) => ({
    "@type": "Question",
    name: question,
    acceptedAnswer: {
      "@type": "Answer",
      text: answer,
    },
  })),
};

const schemas = faqSchema ? [articleSchema, faqSchema] : articleSchema;
---

<BaseLayout
  title={`${frontmatter.title} | Iida Lehtonen`}
  description={frontmatter.description}
  image={socialImage.src}
  imageAlt={frontmatter.heroAlt}
  imageWidth={1200}
  imageHeight={630}
  type="article"
  publishDate={frontmatter.publishDate}
  updatedDate={frontmatter.updatedDate}
  tags={frontmatter.tags}
  schema={schemas}
>
  <Header />

  <main class="article-page">
    <article>
      <Container>
        <header class="article__header">
          <div class="article__meta" aria-label="Article information">
            {frontmatter.tags[0] && (
              <span class="article__category">{frontmatter.tags[0]}</span>
            )}
            <span class="article__separator" aria-hidden="true"></span>
            <time datetime={frontmatter.publishDate.toISOString()}>
              {formattedPublishDate}
            </time>
            <span class="article__separator" aria-hidden="true"></span>
            <span>{frontmatter.readingTime} min read</span>
          </div>

          <h1>{frontmatter.title}</h1>

          <p class="article__lead">{frontmatter.excerpt}</p>
        </header>

        <figure class="article__hero">
          <Image
            class="article__hero-image"
            src={frontmatter.heroImage}
            alt={frontmatter.heroAlt}
            widths={[640, 1660, 1024]}
            sizes="(max-width: 1024px) calc(100vw - 2rem), 992px"
            format="webp"
            loading="eager"
            fetchpriority="high"
          />
        </figure>

        <div class="article__body">
          <slot />
        </div>

        {frontmatter.faq && (
          <section class="article__faq" aria-labelledby="article-faq-title">
            <h2 id="article-faq-title">Frequently asked questions</h2>
            <div class="article__faq-list">
              {frontmatter.faq.map(({ question, answer }) => (
                <details class="article__faq-item">
                  <summary>
                    <h3>{question}</h3>
                    <span aria-hidden="true"></span>
                  </summary>
                  <p>{answer}</p>
                </details>
              ))}
            </div>
          </section>
        )}

        {frontmatter.sources && (
          <section
            class="article__sources article__body"
            aria-labelledby="article-sources-title"
          >
            <h2 id="article-sources-title">Sources</h2>
            <ul>
              {frontmatter.sources.map(({ title, url }) => (
                <li><a href={url}>{title}</a></li>
              ))}
            </ul>
          </section>
        )}

        <div class="article__footer">
          <div class="article__tags" aria-label="Article topics">
            {frontmatter.tags.map((tag) => <span>{tag}</span>)}
          </div>
          <AuthorBox />
        </div>
      </Container>
    </article>
  </main>

  <Footer />
</BaseLayout>

<style>
  .article-page {
    padding-top: 5.5rem;
  }

  article {
    padding-block: clamp(3.5rem, 8vw, 7rem) 0;
  }

  .article__header {
    max-width: 58rem;
    margin-inline: auto;
    text-align: center;
  }

  .article__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    margin-bottom: var(--space-md);
    color: var(--color-text-muted);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .article__category {
    color: var(--color-accent);
  }

  .article__separator {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.65;
  }

  .article__header h1 {
    font-size: clamp(3.25rem, 8vw, 6.5rem);
    text-wrap: balance;
  }

  .article__lead {
    max-width: 46rem;
    margin: var(--space-md) auto 0;
    color: var(--color-text-muted);
    font-family: var(--font-heading);
    font-size: clamp(1.35rem, 2.4vw, 1.85rem);
    line-height: 1.45;
    text-wrap: balance;
  }

  .article__hero {
    width: min(100%, 62rem);
    aspect-ratio: 5 / 2;
    margin: clamp(3rem, 7vw, 5rem) auto clamp(3.5rem, 8vw, 6rem);
    overflow: hidden;
    background: var(--color-surface);
  }

  .article__hero :global(.article__hero-image) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .article__body,
  .article__faq,
  .article__footer {
    width: min(100%, 50rem);
    margin-inline: auto;
  }

  .article__faq {
    width: min(100%, 50rem);
    margin-top: clamp(4rem, 8vw, 6rem);
  }

  .article__sources {
    margin-top: clamp(3rem, 6vw, 4rem);
    padding-top: var(--space-md);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .article__faq > h2 {
    margin-bottom: 1.5rem;
    font-size: clamp(1.55rem, 3vw, 1.9rem);
    letter-spacing: -0.01em;
  }

  .article__faq-list {
    width: 100%;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
  }

  .article__faq-item {
    border-bottom: 1px solid rgba(255, 255, 255, 0.18);
  }

  .article__faq-item summary {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1.5rem;
    align-items: center;
    padding-block: 1.4rem;
    cursor: pointer;
    list-style: none;
  }

  .article__faq-item summary::-webkit-details-marker {
    display: none;
  }

  .article__faq-item summary h3 {
    margin: 0;
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: clamp(0.95rem, 1.5vw, 1.1rem);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.4;
  }

  .article__faq-item summary span {
    position: relative;
    width: 1rem;
    height: 1rem;
  }

  .article__faq-item summary span::before,
  .article__faq-item summary span::after {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1px;
    background: currentColor;
    content: "";
  }

  .article__faq-item summary span::after {
    transform: rotate(90deg);
    transition: transform 0.2s ease;
  }

  .article__faq-item[open] summary span::after {
    transform: rotate(0);
  }

  .article__faq-item p {
    max-width: 44rem;
    margin: 0;
    padding: 0 2.5rem 1.5rem 0;
    color: var(--color-text-muted);
    font-size: clamp(1rem, 1.5vw, 1.1rem);
    line-height: 1.75;
  }

  .article__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding-block: var(--space-md);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .article__tags span {
    padding: 0.5rem 0.8rem;
    border: 1px solid rgba(200, 169, 106, 0.4);
    color: var(--color-accent);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  @media (max-width: 768px) {
    .article-page {
      padding-top: 4.75rem;
    }

    article {
      padding-top: 3rem;
    }

    .article__meta {
      gap: 0.5rem;
    }

    .article__header h1 {
      font-size: clamp(2.75rem, 14vw, 4.5rem);
    }

    .article__hero {
      width: auto;
      margin-inline: -1rem;
    }
  }
</style>

<style is:global>
  .article__body {
    color: var(--color-text-muted);
    font-size: clamp(1rem, 1.5vw, 1.1rem);
    line-height: 1.85;
  }

  .article__body > :first-child {
    margin-top: 0;
  }

  .article__body > :last-child {
    margin-bottom: 0;
  }

  .article__body p,
  .article__body ul,
  .article__body ol,
  .article__body blockquote,
  .article__body pre,
  .article__body table,
  .article__body figure {
    margin-block: 0 1.75rem;
  }

  .article__body h2,
  .article__body h3,
  .article__body h4,
  .article__body h5,
  .article__body h6 {
    color: var(--color-text);
    font-family: var(--font-body);
    text-wrap: balance;
  }

  .article__body h2 {
    margin: 4rem 0 1.25rem;
    font-size: clamp(2.25rem, 5vw, 3.3rem);
    letter-spacing: -0.02em;
  }

  .article__body h3 {
    margin: 2.75rem 0 1rem;
    font-size: clamp(1.6rem, 3vw, 2.1rem);
  }

  .article__body strong {
    color: var(--color-text);
    font-weight: 600;
  }

  .article__body a {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-color: rgba(200, 169, 106, 0.5);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    transition: text-decoration-color 0.2s ease;
  }

  .article__body a:hover {
    text-decoration-color: currentColor;
  }

  .article__body ul,
  .article__body ol {
    padding-left: 1.4rem;
  }

  .article__body li {
    padding-left: 0.35rem;
    margin-bottom: 0.65rem;
  }

  .article__body li::marker {
    color: var(--color-accent);
    font-size: inherit;
    font-weight: 600;
  }

  .article__body blockquote {
    position: relative;
    padding: 0.4rem 0 0.4rem 2rem;
    border-left: 2px solid var(--color-accent);
  }

  .article__body blockquote p {
    color: var(--color-text);
    font-family: var(--font-heading);
    font-size: clamp(1.4rem, 3vw, 1.85rem);
    font-style: italic;
    line-height: 1.5;
  }

  .article__body blockquote p:last-child {
    margin-bottom: 0;
  }

  .article__body code {
    padding: 0.15em 0.35em;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    background: var(--color-surface);
    color: var(--color-text);
    font-size: 0.88em;
  }

  .article__body pre {
    overflow-x: auto;
    padding: 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: var(--color-surface);
    line-height: 1.65;
  }

  .article__body pre code {
    padding: 0;
    border: 0;
    background: transparent;
    font-size: 0.9rem;
  }

  .article__body img {
    display: block;
    width: 100%;
    height: auto;
    margin-block: 2.5rem;
  }

  .article__body figcaption {
    margin-top: -1.75rem;
    color: var(--color-text-muted);
    font-size: 0.8rem;
    text-align: center;
  }

  .article__body .rendering-diagram {
    margin-block: 3rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid #3a3a36;
    background: #0a0a09;
    color: #fff;
  }

  .article__body .rendering-diagram__title {
    margin: 0;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid #fff;
    color: #fff;
    font-size: clamp(1.25rem, 3vw, 1.7rem);
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .article__body .rendering-diagram__comparison {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 6vw, 4rem);
    padding-block: 2rem;
  }

  .article__body .rendering-diagram__path h3 {
    min-height: 2.5em;
    margin: 0 0 1.5rem;
    color: #fff;
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .article__body .rendering-diagram__path {
    display: flex;
    flex-direction: column;
  }

  .article__body .rendering-diagram__steps {
    display: flex;
    flex: 1;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .article__body .rendering-diagram__steps--short {
    justify-content: space-between;
  }

  .article__body
    .rendering-diagram__steps--short
    li:not(:last-child) {
    margin-bottom: 0;
  }

  .article__body .rendering-diagram__steps li {
    position: relative;
    margin: 0;
    padding: 0.7rem 0;
    border-top: 1px solid #3a3a36;
    color: #fff;
    font-size: 0.95rem;
    line-height: 1.4;
  }

  .article__body .rendering-diagram__steps li:not(:last-child) {
    margin-bottom: 1.5rem;
  }

  .article__body .rendering-diagram__steps li:not(:last-child)::after {
    position: absolute;
    top: calc(100% + 0.25rem);
    left: 0.15rem;
    color: #a7a7a1;
    content: "↓";
    font-size: 1rem;
    line-height: 1;
  }

  .article__body .rendering-diagram__result {
    font-weight: 700;
  }

  .article__body .rendering-diagram__result--success span {
    color: #16803a;
  }

  .article__body .rendering-diagram__result--warning span {
    color: #c65d14;
  }

  .article__body .rendering-diagram figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.45rem;
    margin: 0;
    padding-top: 1.25rem;
    border-top: 1px solid #fff;
    color: #fff;
    font-size: 0.9rem;
    line-height: 1.5;
    text-align: left;
  }

  .article__body .rendering-diagram figcaption strong {
    color: #fff;
  }

  .article__body table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
  }

  .article__body th,
  .article__body td {
    padding: 0.8rem 1rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    text-align: left;
    vertical-align: top;
  }

  .article__body th {
    background: var(--color-surface);
    color: var(--color-text);
    font-weight: 600;
  }

  .article__body hr {
    margin-block: 3.5rem;
    border: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  @media (max-width: 600px) {
    .article__body {
      line-height: 1.75;
    }

    .article__body h2 {
      margin-top: 3rem;
    }

    .article__body blockquote {
      padding-left: 1.25rem;
    }

    .article__body table {
      table-layout: fixed;
      white-space: normal;
    }

    .article__body th:first-child,
    .article__body td:first-child {
      width: 34%;
    }

    .article__body th,
    .article__body td {
      padding: 0.7rem 0.75rem;
      overflow-wrap: anywhere;
    }

    .article__body pre {
      margin-inline: -1rem;
      padding: 1.25rem 1rem;
    }

    .article__body .rendering-diagram {
      margin-inline: -1rem;
      padding: 1.25rem 1rem;
    }

    .article__body .rendering-diagram__comparison {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding-block: 1.5rem;
    }

    .article__body .rendering-diagram__path + .rendering-diagram__path {
      padding-top: 2rem;
      border-top: 3px solid #fff;
    }

    .article__body .rendering-diagram__path h3 {
      min-height: 0;
      margin-bottom: 1rem;
    }

    .article__body .rendering-diagram figcaption {
      display: grid;
      gap: 0.1rem;
    }
  }
</style>
