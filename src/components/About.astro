---
import { Image } from "astro:assets";
import iidaPortrait from "../assets/images/iida.jpg";
import Container from "./Container.astro";
---

<section id="about">
  <Container>
    <div class="about__grid">
      <div class="about__image">
        <Image
          src={iidaPortrait}
          alt="Portrait of Iida Lehtonen"
          widths={[320, 480, 640]}
          sizes="(max-width: 768px) calc(100vw - 2rem), 27vw"
          format="webp"
          loading="eager"
        />
      </div>

      <div class="about__content">
        <h2>About</h2>

        <p class="section-intro">
          Bringing together content strategy, SEO, AI and technology to build websites that perform today and adapt to tomorrow.
        </p>

        <p>
          I work at the intersection of content strategy, technical SEO and AI, improving search visibility, creating better customer experiences, and building lightweight tools that support better decisions. I'm especially interested in applying AI to real-world problems, turning experiments into practical workflows that save time and improve quality.
        </p>

        <a class="about__link" href="/about/">
          Read more about me <span aria-hidden="true">→</span>
        </a>

        <div class="about__stats">
          <div class="stat">
            <span class="stat__value">9+</span>
            <span class="stat__label">Years in Digital Marketing</span>
          </div>

          <div class="stat">
            <span class="stat__value">AI</span>
            <span class="stat__label">Building AI-powered workflows</span>
          </div>

          <div class="stat">
            <span class="stat__value">SEO</span>
            <span class="stat__label">Technical SEO and Content Strategy</span>
          </div>
        </div>
        
      </div>
    </div>
  </Container>
</section>
<style>
 
  #about {
    padding-bottom: var(--space-xl);
  }

    .section-intro {
  max-width: 48rem;
  margin-bottom: var(--space-md);
  font-size: 1.2rem;
  line-height: 1.6;
  color: var(--color-text);
}
    
.about__grid {
  display: grid;
  grid-template-columns: 0.9fr 2.1fr;
  gap: var(--space-xl);
  align-items: start;
}
    
    .about__content {
      display: flex;
      flex-direction: column;
      gap: var(--space-xs);
    }

    .about__image {
      aspect-ratio: 4 / 5;
      overflow: hidden;
      border-radius: 12px;
    }

    .about__image img {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
      object-position: 50% 35%;
    }

    .about__stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-lg);
      margin-top: var(--space-sm);
      border-top: 1px solid rgba(255,255,255,.08);
    }

    .about__link {
      align-self: flex-start;
      margin-top: var(--space-sm);
      padding-bottom: 0.2rem;
      border-bottom: 1px solid var(--color-accent);
      font-size: 0.9rem;
      font-weight: 600;
    }

    .about__link:hover {
      color: var(--color-accent);
    }

    .stat {
      display: flex;
      flex-direction: column;
      gap: .25rem;
    }

    .stat__value {
      font-family: var(--font-heading);
      font-size: 2.75rem;
      font-weight: 600;
      line-height: 1;
      color: var(--color-accent);
    }

    .stat__label {
      font-family: var(--font-body);
      font-size: .9rem;
      text-transform: uppercase;
      letter-spacing: .08em;
      color: var(--color-muted);
    }

    @media (max-width: 768px) {
  .about__grid {
    grid-template-columns: 1fr;
    gap: var(--space-lg);
    grid-template-areas:
      "image"
      "content";
  }

  .about__image {
    grid-area: image;
  }

  .about__content {
    grid-area: content;
  }

  .about__stats {
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }
}
    
    </style>
