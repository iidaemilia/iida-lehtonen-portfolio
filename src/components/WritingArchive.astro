---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

import Container from "./Container.astro";
import { getWritingPagePath } from "../utils/writing";

interface Props {
  articles: CollectionEntry<"blog">[];
  currentPage: number;
  totalPages: number;
}

const { articles, currentPage, totalPages } = Astro.props;
const pageNumbers = Array.from({ length: totalPages }, (_, index) => index + 1);
const previousPage = currentPage > 1 ? currentPage - 1 : undefined;
const nextPage = currentPage < totalPages ? currentPage + 1 : undefined;

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });
---

<main class="writing-page">
  <Container>
    <header class="writing-header">
      <p class="writing-header__eyebrow">Ideas & observations</p>
      <h1>Writing</h1>
      <p class="writing-header__intro">
        Notes on SEO, AI, content strategy and building better digital
        experiences.
      </p>
    </header>

    <section
      class="article-list"
      aria-label={`Articles, page ${currentPage} of ${totalPages}`}
    >
      {articles.map((article, index) => (
        <article class="article-card">
          <a class="article-card__link" href={`/writing/${article.id}/`}>
            <div class="article-card__image">
              <Image
                src={article.data.heroImage}
                alt={article.data.heroAlt}
                widths={[480, 720, 960]}
                sizes="(max-width: 768px) calc(100vw - 2rem), 45vw"
                format="webp"
                loading={index === 0 ? "eager" : "lazy"}
              />
            </div>

            <div class="article-card__content">
              <div class="article-card__meta">
                <time datetime={article.data.publishDate.toISOString()}>
                  {formatDate(article.data.publishDate)}
                </time>
                <span aria-hidden="true"></span>
                <span>{article.data.readingTime} min read</span>
              </div>

              <h2>{article.data.title}</h2>
              <p class="article-card__excerpt">{article.data.excerpt}</p>

              <div class="article-card__tags" aria-label="Topics">
                {article.data.tags.map((tag) => <span>{tag}</span>)}
              </div>

              <span class="article-card__cta">
                Read article <span aria-hidden="true">→</span>
              </span>
            </div>
          </a>
        </article>
      ))}
    </section>

    {totalPages > 1 && (
      <nav class="writing-pagination" aria-label="Writing pagination">
        {previousPage && (
          <a
            class="writing-pagination__direction writing-pagination__previous"
            href={getWritingPagePath(previousPage)}
            rel="prev"
          >
            <span aria-hidden="true">←</span> Previous
          </a>
        )}

        <ol class="writing-pagination__pages">
          {pageNumbers.map((pageNumber) => (
            <li>
              {pageNumber === currentPage ? (
                <span aria-current="page">{pageNumber}</span>
              ) : (
                <a href={getWritingPagePath(pageNumber)}>{pageNumber}</a>
              )}
            </li>
          ))}
        </ol>

        {nextPage && (
          <a
            class="writing-pagination__direction writing-pagination__next"
            href={getWritingPagePath(nextPage)}
            rel="next"
          >
            Next <span aria-hidden="true">→</span>
          </a>
        )}
      </nav>
    )}
  </Container>
</main>

<style>
  .writing-page {
    padding-top: 5.5rem;
  }

  .writing-header {
    max-width: 50rem;
    padding-block: clamp(3rem, 6vw, 5rem) clamp(2.5rem, 5vw, 3.5rem);
  }

  .writing-header__eyebrow {
    margin-bottom: var(--space-sm);
    color: var(--color-accent);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .writing-header h1 {
    font-size: clamp(4rem, 10vw, 7rem);
  }

  .writing-header__intro {
    max-width: 42rem;
    margin-top: var(--space-md);
    font-size: clamp(1.15rem, 2vw, 1.35rem);
  }

  .article-list {
    padding: 0;
  }

  .article-card {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .article-card__link {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(20rem, 0.9fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }

  .article-card__image {
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: var(--color-surface);
  }

  .article-card__image :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .article-card__link:hover .article-card__image :global(img) {
    transform: scale(1.025);
  }

  .article-card__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .article-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: var(--space-sm);
    color: var(--color-text-muted);
    font-size: 0.75rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .article-card__meta > span[aria-hidden="true"] {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: currentColor;
  }

  .article-card h2 {
    color: var(--color-text);
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 3.25rem);
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .article-card__excerpt {
    margin-top: var(--space-sm);
    font-size: 1.05rem;
  }

  .article-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }

  .article-card__tags span {
    color: var(--color-accent);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .article-card__tags span:not(:last-child)::after {
    margin-left: 0.5rem;
    color: var(--color-text-muted);
    content: "/";
  }

  .article-card__cta {
    margin-top: var(--space-md);
    padding-bottom: 0.2rem;
    border-bottom: 1px solid var(--color-accent);
    color: var(--color-text);
    font-size: 0.9rem;
    font-weight: 600;
    transition: color 0.2s ease;
  }

  .article-card__link:hover .article-card__cta {
    color: var(--color-accent);
  }

  .writing-pagination {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--space-md);
    align-items: center;
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .writing-pagination__direction {
    color: var(--color-text);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .writing-pagination__previous {
    grid-column: 1;
    justify-self: start;
  }

  .writing-pagination__next {
    grid-column: 3;
    justify-self: end;
  }

  .writing-pagination__pages {
    display: flex;
    grid-column: 2;
    gap: 0.5rem;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .writing-pagination__pages a,
  .writing-pagination__pages span {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    color: var(--color-text);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .writing-pagination__pages span[aria-current="page"] {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-background);
  }

  .writing-pagination a:hover {
    color: var(--color-accent);
  }

  @media (max-width: 768px) {
    .writing-page {
      padding-top: 4.75rem;
    }

    .writing-header {
      padding-block: 2.75rem 2.5rem;
    }

    .article-card__link {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }

    .article-card__image {
      aspect-ratio: 16 / 9;
    }

    .writing-pagination {
      grid-template-columns: 1fr auto 1fr;
      gap: var(--space-sm);
    }

    .writing-pagination__direction {
      font-size: 0.8rem;
    }
  }
</style>
