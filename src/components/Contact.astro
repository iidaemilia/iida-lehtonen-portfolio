---
import Container from "../components/Container.astro";
---

<section id="contact">
    <Container>
      <div class="contact__grid">
        <div class="contact__content">
          <p class="contact__eyebrow">Get in touch</p>

          <h2>Let's Connect</h2>

          <p class="section-intro">
            Interested in digital strategy, SEO, AI or simply want to exchange ideas? I'd love to hear from you.
          </p>
        </div>

        <div class="contact__links">
          <a href="https://www.linkedin.com/in/iidalehtonen/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a href="https://github.com/iidaemilia" target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href="mailto:iida.e.lehtonen@gmail.com">Email</a>
        </div>
      </div>
    </Container>
  </section>
<style>
#contact {
  padding-top: var(--space-sm);
  padding-bottom: var(--space-2xl);
}

.contact__grid {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: var(--space-sm);
}

.contact__eyebrow {
  color: var(--color-accent);
  text-transform: uppercase;
  letter-spacing: .18em;
  font-size: .85rem;
  margin-bottom: var(--space-sm);
}

#contact h2 {
  line-height: .95;
  margin-bottom: var(--space-md);
}

#contact h2 span {
  color: var(--color-accent);
  font-style: italic;
}

.section-intro {
  max-width: 42rem;
  margin: 0 auto;
  color: var(--color-muted);
  margin-bottom: 0;
}

.contact__links {
  display: flex;
  flex-direction: row;
  justify-content: center;
  gap: var(--space-md);
  flex-wrap: wrap;
  margin-top: var(--space-sm);
}

.contact__links a {
  padding: 0.85rem 1.4rem;
  min-height: 56px;
  min-width: 180px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 500;
  font-size: 1.05rem;
  border-radius: 0;
  background: transparent;
  border: 1px solid var(--color-accent);
  color: var(--color-text);
  text-decoration: none;
  transition: border-color .2s ease, transform .2s ease;
}

.contact__links a:hover {
  background: rgba(212, 175, 55, 0.08);
  transform: translateY(-2px);
}

@media (max-width: 768px) {
  .contact__links {
    flex-direction: column;
    width: 100%;
  }

  .contact__links a {
    width: 100%;
  }
}
</style>
