---
import Container from "./Container.astro";
---

<footer>
  <Container>
    <div class="footer__content">
      <p>© 2026 Iida Lehtonen</p>
      <p>Designed, written and built with Astro.</p>
    </div>
  </Container>
</footer>
<style>
footer {
    margin-top: var(--space-xl);
    padding: 2rem 0;
    border-top: 1px solid rgba(255,255,255,.08);
}

.footer__content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
}

.footer__content p {
    color: var(--color-text-muted);
    font-size: .9rem;
    margin: 0;
}

@media (max-width: 768px) {
  .footer__content {
    flex-direction: column;
    text-align: center;
  }
}
</style>